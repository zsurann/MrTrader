# MemeDesk (PAPER ONLY) — copy to a chmod 600 file and fill in values.
# Never commit real values. On a VM, load them with:
#   EnvironmentFile=/etc/memedesk/memedesk.env

# Solana RPC (Helius free tier) and Jupiter quotes (quote-only, no signing)
HELIUS_API_KEY=
JUPITER_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard sync (syncer.py POSTs to the desk-ingest Edge Function)
SUPABASE_URL=
SUPABASE_ANON_KEY=
DESK_INGEST_TOKEN=

# Optional: dashboard frontend build (anon / SELECT-only key, never the service role)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override data directory (default: the directory that contains desk.py)
# MEMEDESK_DATA=
