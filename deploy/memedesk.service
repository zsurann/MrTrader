[Unit]
Description=MemeDesk PAPER desk supervisor (desk + syncer + smartwallets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=memedesk
Group=memedesk
WorkingDirectory=/opt/memedesk
EnvironmentFile=/etc/memedesk/memedesk.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /opt/memedesk/run.sh
KillMode=control-group
Restart=always
RestartSec=10
TimeoutStopSec=30
# Limits sized for a ~1 GB Always Free VM (desk + syncer + smartwallets in one cgroup)
MemoryHigh=700M
MemoryMax=850M
OOMScoreAdjust=-300
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/memedesk
IOSchedulingClass=best-effort
IOSchedulingPriority=4

[Install]
WantedBy=multi-user.target
